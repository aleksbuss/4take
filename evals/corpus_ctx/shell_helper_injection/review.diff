 from deploy.git_tools import run_git
+from deploy.http import json_response
+
+
+def switch_branch(request):
+    branch = request.json["branch"]
+    try:
+        output = run_git("checkout", branch)
+    except Exception:
+        pass
+    return json_response({"branch": branch, "output": output})
